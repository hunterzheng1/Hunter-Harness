# Harness bundles/manifests must hash identically on Linux and Windows CI.
resources/harness/** text eol=lf
harness/** text eol=lf

# Frozen archive evidence is content-addressed and must never be EOL-normalized.
.harness/archive/** -text

# Frozen migration fixtures must keep committed bytes (CRLF) on all platforms.
packages/core/test/fixtures/v0.1.1-bundles/** -text

# Stage 01 canonical contract artifacts are hashed byte-for-byte across repositories.
packages/contracts/openapi/hunter-harness-v1.yaml text eol=lf
packages/contracts/openapi/hunter-harness-v1.yaml.sha256 text eol=lf
packages/contracts/src/content-sync.ts text eol=lf
packages/contracts/test/fixtures/content-sync-v0-legacy.json text eol=lf
packages/contracts/test/fixtures/content-sync-v1-current.json text eol=lf
